#!/usr/bin/env bash
# ffmpeg fallback wrapper for the uv environment.
#
# WHY THIS EXISTS
#
# `ns-process-data` shells out to ffmpeg even for an image dataset, and ffmpeg
# cannot come from uv: it is a system binary. On the development machine it was
# never installed system-wide. It exists only inside the conda prefix, which is
# NOT on PATH under uv, so a uv run died four seconds into stage 2 with:
#
#   Could not find ffmpeg. Please install ffmpeg.
#
# THE PREFERRED FIX IS STILL `sudo apt install ffmpeg`. That makes ffmpeg a
# genuine system dependency, which is what QUICKSTART.md tells a new user to do,
# and then this wrapper is unnecessary. It exists so the uv path works on a
# machine where ffmpeg happens to live only in a conda prefix, without pulling
# that whole prefix onto PATH.
#
# Resolution order:
#   1. a real ffmpeg elsewhere on PATH (this wrapper steps aside)
#   2. $DT4AG_FFMPEG, an explicit path
#   3. $DT4AG_COLMAP_PREFIX/bin/ffmpeg, reusing the prefix already configured
#
# Unlike the colmap wrapper this does NOT set LD_LIBRARY_PATH. A conda ffmpeg
# resolves its own libraries through its RPATH, and exporting the prefix's lib/
# globally is exactly what makes torch load the wrong libcudart.

set -euo pipefail

self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 1. A real ffmpeg somewhere else on PATH wins. Strip this directory out so we
#    cannot find ourselves and recurse.
stripped="$(printf '%s' "${PATH:-}" | tr ':' '\n' | grep -vxF "$self" | paste -sd: -)"
if real="$(PATH="$stripped" command -v ffmpeg 2>/dev/null)"; then
    exec "$real" "$@"
fi

# 2. Explicit override.
if [[ -n "${DT4AG_FFMPEG:-}" ]]; then
    if [[ ! -x "$DT4AG_FFMPEG" ]]; then
        echo "ffmpeg wrapper: DT4AG_FFMPEG is set but not executable: $DT4AG_FFMPEG" >&2
        exit 2
    fi
    exec "$DT4AG_FFMPEG" "$@"
fi

# 3. Reuse the COLMAP prefix, which on this machine also carries ffmpeg.
if [[ -n "${DT4AG_COLMAP_PREFIX:-}" && -x "$DT4AG_COLMAP_PREFIX/bin/ffmpeg" ]]; then
    exec "$DT4AG_COLMAP_PREFIX/bin/ffmpeg" "$@"
fi

echo "ffmpeg wrapper: could not find an ffmpeg to run." >&2
echo "  Install it system-wide (preferred):  sudo apt install ffmpeg" >&2
echo "  or set DT4AG_FFMPEG=/path/to/ffmpeg" >&2
echo "  or set DT4AG_COLMAP_PREFIX to a prefix that also contains bin/ffmpeg." >&2
exit 2
